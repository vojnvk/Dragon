{
  "name": "dragon",
  "version": "1.1.0",
  "description": "Easy YouTube downloader for Windows and macOS. Paste a link, get the video in the best quality, the thumbnail and the title.",
  "private": true,
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/vojnvk/Dragon",
  "repository": {
    "type": "git",
    "url": "https://github.com/vojnvk/Dragon.git"
  },
  "license": "MIT",
  "author": "vojnvk",
  "keywords": [
    "youtube",
    "downloader",
    "youtube-downloader",
    "yt-dlp",
    "electron",
    "video",
    "mp4",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently -k -n next,electron -c cyan,magenta \"npm:dev:next\" \"npm:dev:electron\"",
    "dev:next": "next dev --port 3000",
    "dev:electron": "wait-on http-get://localhost:3000 && node scripts/build-electron.mjs && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 electron .",
    "build": "next build && node scripts/build-electron.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "test": "node --test \"electron/**/*.test.ts\"",
    "lint": "eslint",
    "postinstall": "node scripts/update-ytdlp.mjs",
    "update-ytdlp": "node scripts/update-ytdlp.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "ffmpeg-static": "^5.3.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
